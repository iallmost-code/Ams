{
  "name": "aetherstory-m",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "An original offline-ready mobile fantasy auto-RPG",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0",
